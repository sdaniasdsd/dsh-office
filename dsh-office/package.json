{
  "name": "dsh-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "modules/*",
    "packages/*"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:modules": "node scripts/check-modules.mjs",
    "doctor": "tsx src/cli.ts doctor",
    "start": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "assemble": "node scripts/assemble.mjs",
    "fetch:toolchain": "node scripts/fetch-toolchain.mjs",
    "configure": "node scripts/configure.mjs",
    "build": "tsc --noEmit",
    "build:dsh": "node scripts/build-dsh.mjs",
    "test:dsh-package-closure": "node scripts/check-dsh-package-closure.mjs",
    "pack:dsh": "node scripts/pack-dsh.mjs",
    "demo": "tsx scripts/demo.ts",
    "provenance": "node scripts/provenance.mjs",
    "assemble:docx-partition": "node scripts/assemble.mjs --source docx=../../docx分区"
  },
  "dependencies": {
    "@docx4j/core-ts": "0.1.5",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.3.289",
    "tsx": "^4.20.5",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "description": "DSH Office 插件外壳：DOCX / PDF / PPTX / XLSX 四个家族模块的装配、注册、打包与交付。"
}
