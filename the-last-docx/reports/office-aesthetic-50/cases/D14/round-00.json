            "ordinal": 54,
            "paraId": null,
            "quote": "第十三条 符合下列情形之一的，个人信息处理者方可处理个人信息：",
            "digest": "4bc72e84c4f3e05cdfe15802b5f8416a7aaa26270425ffa5645a7bdcd2a5cf79"
          }
        },
        "spaceBefore": 6,
