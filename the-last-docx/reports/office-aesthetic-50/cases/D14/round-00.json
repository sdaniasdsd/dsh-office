            "structuralPath": "/w:document/w:body/w:p[69]",
            "ordinal": 68,
            "paraId": null,
            "quote": "第十七条 个人信息处理者在处理个人信息前，应当以显著方式、清晰易懂的语言真实、准确、完整地向个人告知下列事项：",
            "digest": "04e6189695bb7b7d034b8b1c86d63867acb464a48a0cb0509d7db2a229adc1ac"
          }
        },
        "spaceBefore": 6,
        "spaceAfter": 3,
        "font": {
          "bold": true,
          "size": 11,
          "color": "#176B67",
          "name": "Arial"
        }
