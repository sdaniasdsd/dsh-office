    "office-core": {
      "optional": true
    },
    "office-safety": {
      "optional": true
    },
    "office-files": {
      "optional": true
    },
    "office-test-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@docx4j/core-ts": "0.1.5",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@dsh-office-profile/docx-parse": "*",
    "@dsh-office-profile/docx-edit": "*",
    "@dsh-office-profile/docx-render": "*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.20.5"
  }
}
