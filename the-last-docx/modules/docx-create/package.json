{
  "name": "@dsh-office-profile/docx-create",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "module.json",
    "schemas",
    "templates",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "fixtures:build": "tsx fixtures/build.ts"
  },
  "peerDependencies": {
    "office-core": "*",
    "office-safety": "*",
    "office-files": "*",
    "office-test-kit": "*"
  },
